== values ==
  Pi = 3.141592653589793
  E  = 2.718281828459045
  a circle of radius 2 has area 12.566370614359172

== roots and powers ==
  Sqrt(16)      = 4
  Cbrt(27)      = 3
  Cbrt(-8)      = -2
  Root(32, 5)   = 2
  Root(-32, 5)  = -2
  Pow(2, 10)    = 1024
  2 ^ 10        = 1024

== logarithms ==
  Log(E)        = 1
  Log(100)      = 4.605170185988092
  Log10(100)    = 2
  Log(100, 10)  = 2
  Log2(1024)    = 10

== angles ==
  Sin(0)        = 0
  Cos(0)        = 1
  Tan(0)        = 0
  Sin(Pi/2)     = 1
  Asin(1)       = 1.5707963267948966
  Acos(1)       = 0
  Atan(1)       = 0.7853981633974483
  Atan2(1, 1)   = 0.7853981633974483
  Atan2(1, -1)  = 2.356194490192345

== measuring and choosing ==
  Abs(-3)       = 3
  Abs(-3.5)     = 3.5
  Abs(-3|4)     = 3|4
  Min(3, 7)     = 3
  Min(3.5, 7.5) = 3.5
  Min(1|3, 1|2) = 1|3
  Max(3, 7)     = 7
  Max(3.5, 7.5) = 7.5
  Max(1|3, 1|2) = 1|2

== rounding ==
  Floor(3.7)    = 3
  Ceiling(3.2)  = 4
  Round(2.5)    = 3
  Round(-2.5)   = -3
  Floor(-7|2)   = -4
  Ceiling(-7|2) = -3
  Round(5|2)    = 3
  names[Floor(3.7)] is three

== counting ==
1 1 2 6 24 120 720 
  Factorial(20) = 2432902008176640000
  Factorial(21) does not fit in an integer
