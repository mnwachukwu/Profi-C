== Console ==
  built one piece at a time.
  a fraction: 3|4
  a boolean:  true

== Math ==
  Sqrt(16.0)     = 4
  Pow(2.0, 8.0)  = 256
  Abs(-3)        = 3
  Abs(-3.5)      = 3.5
  Abs(-3|4)      = 3|4
  Min(3, 7)      = 3
  Min(1|3, 1|2)  = 1|3
  Max(3.5, 7.5)  = 7.5
  Floor(3.7)     = 3
  Ceiling(3.2)   = 4
  Round(2.5)     = 3
  Floor(-7|2)    = -4
  2.0 ^ 8.0      = 256

== members of a set ==
  Count()        = 3
  IndexOf(30)    = 2
  Contains(99)   = false
  after inserts  = {50, 40, 10, 30, 20}
  Remove(10)     = true
  after removals = {40, 30, 20}
  after Clear()  = 0 left
  Subset(2)      = {30, 40, 50}
  Subset(1, 3)   = {20, 30}
  the two halves = {10, 20} and {30, 40, 50}

== a set of optionals ==
  as written     = {empty, 1, empty, 2, empty}
  TrimStart()    = {1, empty, 2, empty}
  TrimEnd()      = {empty, 1, empty, 2}
  Trim()         = {1, empty, 2}
  TrimAll()      = {1, 2}, and needs no unwrapping
  original still = {empty, 1, empty, 2, empty}

== members of a string ==
  Count()            = 11
  Contains("gram")   = true
  IndexOf("gram")    = 3
  Substring(3, 4)    = gram
  Subset(3, 7)       = gram
  Subset(3)          = gramming
  Insert("!")        = programming!
  Remove("m")        = prograing
  RemoveAt(0)        = rogramming
  InsertAt(0, ">")   = >programming
  Trim() on "  hi  " = [hi]
  Trim("x")          = [hi]
  Trim({'x', 'y'})   = [hi]
  TrimStart()        = [hi  ]
  TrimEnd()          = [  hi]
  one letter at a time: p r o g r a m m i n g 

== members of an optional ==
  missing.HasValue() = false
  present.HasValue() = true
  missing.Or(0)      = 0
  present.Value()    = 42
  missing.Value()    -> refused, as it should be

== Reference ==
  a == b                  = true
  Reference.Equals(a, b)  = false
  Reference.Equals(a, c)  = true
  after c.Insert(4), a is {1, 2, 3, 4}

