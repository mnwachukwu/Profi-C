== Console ==
  built one piece at a time.
  a fraction: 3|4
  a boolean:  true

== Math ==
  Sqrt(16.0)     = 4
  Pow(2.0, 8.0)  = 256
  Abs(-3)        = 3
  Abs(-3.5)      = 3.5
  Abs(-3|4)      = 3|4
  Min(3, 7)      = 3
  Min(1|3, 1|2)  = 1|3
  Max(3.5, 7.5)  = 7.5
  Floor(3.7)     = 3
  Ceiling(3.2)   = 4
  Round(2.5)     = 3
  Floor(-7|2)    = -4
  2.0 ^ 8.0      = 256

== Random ==
  seeded 42, six rolls:  2 3 2 3 4 1 
  the same seed again:   2 3 2 3 4 1 
  Random.Next() is whole and not negative: true
  Random.Next(5) is below five:            true
  Random.NextDouble() is below one:        true

== DateTime ==
  landing            = 1969-07-20
  liftoff            = 1969-07-16 13:32:00
  landing.Year       = 1969
  landing.Month      = 7
  landing.Day        = 20
  landing.DayOfWeek  = 0 (Sunday is 0)
  landing.DayOfYear  = 201
  liftoff.Hour       = 13
  AddDays(10)        = 1969-07-30
  AddDays(0.5)       = 1969-07-20 12:00:00
  AddYears(1)        = 1970-07-20
  AddMonths(2)       = 1969-09-20
  landing unchanged  = 1969-07-20
  liftoff came first = true
  Today has no time  = true

== TimeSpan, Date and Time ==
  the mission took   = 4.06:45:40
  its days part      = 4
  its hours part     = 6
  in hours altogether= 103
  liftoff plus it    = 1969-07-20 20:17:40
  ninety minutes     = 01:30:00
  half minus a whole = -00:30:00
  a date             = 1969-07-20
  its day of week    = 0 (Sunday is 0)
  a time             = 09:00:00
  eight hours later  = 01:30:00
  that day at nine   = 1969-07-20 09:00:00
  landing's date     = 1969-07-20
  landing's time     = 20:17:40

== members of a set ==
  Count()        = 3
  IndexOf(30)    = 2
  Contains(99)   = false
  after inserts  = {50, 40, 10, 30, 20}
  Remove(10)     = true
  after removals = {40, 30, 20}
  after Clear()  = 0 left
  Subset(2)      = {30, 40, 50}
  Subset(1, 3)   = {20, 30}
  the two halves = {10, 20} and {30, 40, 50}

== a set of optionals ==
  as written     = {empty, 1, empty, 2, empty}
  TrimStart()    = {1, empty, 2, empty}
  TrimEnd()      = {empty, 1, empty, 2}
  Trim()         = {1, empty, 2}
  TrimAll()      = {1, 2}, and needs no unwrapping
  original still = {empty, 1, empty, 2, empty}

== members of a string ==
  Count()            = 11
  Contains("gram")   = true
  IndexOf("gram")    = 3
  Substring(3, 4)    = gram
  Subset(3, 7)       = gram
  Subset(3)          = gramming
  Insert("!")        = programming!
  Remove("m")        = prograing
  RemoveAt(0)        = rogramming
  InsertAt(0, ">")   = >programming
  Trim() on "  hi  " = [hi]
  Trim("x")          = [hi]
  Trim({'x', 'y'})   = [hi]
  TrimStart()        = [hi  ]
  TrimEnd()          = [  hi]
  one letter at a time: p r o g r a m m i n g 

== members of an optional ==
  missing.HasValue() = false
  present.HasValue() = true
  missing.Or(0)      = 0
  present.Value()    = 42
  missing.Value()    -> refused, as it should be

== Reference ==
  a == b                  = true
  Reference.Equals(a, b)  = false
  Reference.Equals(a, c)  = true
  after c.Insert(4), a is {1, 2, 3, 4}

