{
  "name": "profi-c",
  "displayName": "Profi-C",
  "description": "Syntax highlighting for Profi-C.",
  "version": "0.1.1",
  "publisher": "profi-c",
  "license": "MIT",
  "engines": { "vscode": "^1.75.0" },
  "devDependencies": {
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.1.0"
  },
  "categories": ["Programming Languages"],
  "contributes": {
    "languages": [
      {
        "id": "profi-c",
        "aliases": ["Profi-C", "profi-c"],
        "extensions": [".pc"],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "profi-c-project",
        "aliases": ["Profi-C Project"],
        "extensions": [".pcp"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "profi-c",
        "scopeName": "source.profi-c",
        "path": "./syntaxes/profi-c.tmLanguage.json"
      },
      {
        "language": "profi-c-project",
        "scopeName": "source.profi-c-project",
        "path": "./syntaxes/profi-c-project.tmLanguage.json"
      }
    ],
    "configurationDefaults": {
      "editor.tokenColorCustomizations": {
        "textMateRules": [
          {
            "scope": "comment.line.number-sign.directive.profi-c",
            "settings": { "foreground": "#7A7A7A" }
          },
          {
            "scope": "constant.language.documentation.profi-c",
            "settings": { "foreground": "#00E5FF" }
          }
        ]
      }
    }
  }
}
