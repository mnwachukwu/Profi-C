##
    Choosing among fixed alternatives.

    A switch compares one value against constant labels. Labels may be grouped, and a
    group runs only its own statements — there is no falling through from one group into the
    next, so nothing has to be written to prevent it.

    Over an enumeration, a switch that leaves members out and writes no 'default' is warned
    about, naming the ones with no case. That is what makes adding a member safe: every switch
    that has to change says so, where it has to change.
##

# @summary: The four suits of a deck of cards.
enumeration Suit
    Hearts, Diamonds, Clubs, Spades
end enumeration

##
    @summary: The thirteen ranks, numbered by what each is worth.

    @remarks: Two is written out and the rest follow from it, so the ordinals and the values
    are the same number.
##
enumeration Rank
    Two = 2, Three, Four, Five, Six, Seven, Eight, Nine, Ten,
    Jack, Queen, King, Ace
end enumeration

shared model Program

    function Main()
        Program.NamingEachOne();
        Program.GroupingLabels();
        Program.LeavingTheRestToDefault();
        Program.SwitchingOnOtherThings();
    end function

    # ---- One case per member --------------------------------------------------------

    ##
        @summary: Names a suit.

        @remarks: Every member has a case, so nothing is left unhandled and the compiler says
        nothing.

        @suit: the suit to name.
        @yields: its name in lower case.
    ##
    string function NameOf(Suit suit)
        switch suit
            case Suit.Hearts:
                yield "hearts";
            case Suit.Diamonds:
                yield "diamonds";
            case Suit.Clubs:
                yield "clubs";
            case Suit.Spades:
                yield "spades";
        end switch

        # Reached only if a suit exists that no case named, which none does.
        yield "unknown";
    end function

    # @summary: A switch where every member has a case, so nothing is warned about.
    function NamingEachOne()
        Suit[] suits = {Suit.Hearts, Suit.Diamonds, Suit.Clubs, Suit.Spades};

        for each suit in suits
            Console.Write(Program.NameOf(suit) + " ");
        end for

        Console.WriteLine();
    end function

    # ---- Grouping labels ------------------------------------------------------------

    ##
        @summary: Which color a suit is printed in.

        @remarks: Several labels may share one group. This is the case other languages need
        'break' for; here a group ends where the next label begins.

        @suit: the suit to look at.
        @yields: "red" or "black".
    ##
    string function ColorOf(Suit suit)
        switch suit
            case Suit.Hearts:
            case Suit.Diamonds:
                yield "red";
            case Suit.Clubs:
            case Suit.Spades:
                yield "black";
        end switch

        yield "unknown";
    end function

    # @summary: Several labels sharing one group of statements.
    function GroupingLabels()
        Console.WriteLine("hearts is " + Program.ColorOf(Suit.Hearts));
        Console.WriteLine("spades is " + Program.ColorOf(Suit.Spades));
    end function

    # ---- Letting a default cover the rest ---------------------------------------------

    ##
        @summary: What a rank is worth in play.

        @remarks: Thirteen ranks and only three worth naming, so a default handles the rest.
        Writing one says "everything else is covered", which is why it silences the warning.

        @rank: the rank to score.
        @yields: its value, with the court cards at ten and an ace at eleven.
    ##
    integer function ValueOf(Rank rank)
        switch rank
            case Rank.Jack:
            case Rank.Queen:
            case Rank.King:
                yield 10;
            case Rank.Ace:
                yield 11;
            default:
                yield rank.ToInteger();
        end switch
    end function

    # @summary: A default, which covers everything not named and silences the warning.
    function LeavingTheRestToDefault()
        Rank[] hand = {Rank.Ace, Rank.King, Rank.Seven};
        integer total = 0;

        for each rank in hand
            total = total + Program.ValueOf(rank);
        end for

        Console.WriteLine("hand is worth " + total);
    end function

    # ---- What else a switch can examine ------------------------------------------------

    ##
        Integers, characters, strings, and booleans may all be switched on. A real or a
        fraction may not: two of those can be equal without being the same numeral, and a case
        label is a comparison the reader has to be able to trust.
    ##
    function SwitchingOnOtherThings()
        string command = "deal";

        switch command
            case "deal":
                Console.WriteLine("dealing");
            case "fold":
                Console.WriteLine("folding");
            default:
                Console.WriteLine("unknown command");
        end switch

        character grade = 'B';

        switch grade
            case 'A':
            case 'B':
                Console.WriteLine("passing");
            default:
                Console.WriteLine("not passing");
        end switch
    end function

end model
