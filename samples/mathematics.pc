##
    Everything Math provides.

    Two of these are values rather than functions, so they are written without
    parentheses. The rest are called, and the compiler says which is which.

    Roots, powers and logarithms all answer in reals, because those are the operations that
    leave the rationals behind: the square root of a fraction is usually irrational, and so is
    the logarithm of almost anything. Measuring, choosing and rounding do not, so each of those
    has a version for every number the language has.
##

shared model Program

    function Main()
        Program.Constants();
        Program.RootsAndPowers();
        Program.Logarithms();
        Program.Angles();
        Program.MeasuringAndChoosing();
        Program.Rounding();
        Program.Counting();
    end function

    # ---- The two values -------------------------------------------------------------

    # @summary: Pi and E, which are values rather than functions.
    function Constants()
        Console.WriteLine("== values ==");
        Console.WriteLine("  Pi = " + Math.Pi);
        Console.WriteLine("  E  = " + Math.E);

        # Neither is a function, so neither is called. Writing Math.Pi() is reported.
        Console.WriteLine("  a circle of radius 2 has area "
                            + Program.ToFourPlaces(Math.Pi * 2.0 * 2.0));
        Console.WriteLine();
    end function

    # ---- Roots and powers -----------------------------------------------------------

    # @summary: Square roots, cube roots, roots of any degree, and raising to a power.
    function RootsAndPowers()
        Console.WriteLine("== roots and powers ==");
        Console.WriteLine("  Sqrt(16)      = " + Math.Sqrt(16.0));
        Console.WriteLine("  Cbrt(27)      = " + Math.Cbrt(27.0));

        # A cube root reaches below zero, where a square root cannot.
        Console.WriteLine("  Cbrt(-8)      = " + Math.Cbrt(-8.0));

        # Root takes the degree, so it covers the ones with no name of their own.
        Console.WriteLine("  Root(32, 5)   = " + Math.Root(32.0, 5.0));
        Console.WriteLine("  Root(-32, 5)  = " + Math.Root(-32.0, 5.0));

        Console.WriteLine("  Pow(2, 10)    = " + Math.Pow(2.0, 10.0));

        # '^' is the operator form, and it keeps a whole answer whole.
        Console.WriteLine("  2 ^ 10        = " + 2 ^ 10);
        Console.WriteLine();
    end function

    # ---- Logarithms -----------------------------------------------------------------

    ##
        @summary: Logarithms, and which base a bare Log means.

        @remarks: Log of ONE number is the NATURAL logarithm — log to base E, what
        mathematicians write as ln. That is what C#, Java and C all mean by the name, and
        Profi-C means it too, so a program moved between them gives the same answer.

        For base ten, write Log10, or Log with the base as a second argument.
    ##
    function Logarithms()
        Console.WriteLine("== logarithms ==");
        Console.WriteLine("  Log(E)        = " + Math.Log(Math.E));
        Console.WriteLine("  Log(100)      = " + Program.ToFourPlaces(Math.Log(100.0)));
        Console.WriteLine("  Log10(100)    = " + Math.Log10(100.0));
        Console.WriteLine("  Log(100, 10)  = " + Math.Log(100.0, 10.0));
        Console.WriteLine("  Log2(1024)    = " + Math.Log2(1024.0));
        Console.WriteLine();
    end function

    ##
        @summary: Shown to four places rather than in full.

        @remarks: A root, a logarithm and an angle are worked out by the machine's own
        arithmetic library, and those are allowed to differ in the last bit from one computer
        to the next. The answer is right either way, but the final digit is not something a
        program should be written to depend on, and rounding first says which digits are being
        claimed.

        Where an exact answer exists it is given exactly, so the lines above that print a whole
        number really do print one everywhere.

        @value: the number to shorten.
        @yields: the same number, rounded to four decimal places.
    ##
    real function ToFourPlaces(real value)
        yield Math.Round(value * 10000.0) / 10000.0;
    end function

    # ---- Angles ---------------------------------------------------------------------

    ##
        Angles are in radians, as they are everywhere else that has these. A half turn is Pi.
        The names are the abbreviations the mathematics is written with, kept as they are
        because they are borrowed rather than invented here.
    ##
    # @summary: The trigonometric six, and their hyperbolic counterparts.
    function Angles()
        Console.WriteLine("== angles ==");

        let quarterTurn = Math.Pi / 2.0;

        Console.WriteLine("  Sin(0)        = " + Math.Sin(0.0));
        Console.WriteLine("  Cos(0)        = " + Math.Cos(0.0));
        Console.WriteLine("  Tan(0)        = " + Math.Tan(0.0));
        Console.WriteLine("  Sin(Pi/2)     = " + Math.Sin(quarterTurn));

        # The inverses, each undoing its own. Asin(1) is a quarter turn, so it is Pi/2.
        Console.WriteLine("  Asin(1)       = " + Program.ToFourPlaces(Math.Asin(1.0)));
        Console.WriteLine("  Acos(1)       = " + Math.Acos(1.0));
        Console.WriteLine("  Atan(1)       = " + Program.ToFourPlaces(Math.Atan(1.0)));

        # Atan2 takes the two sides rather than their ratio, so it knows the quadrant.
        Console.WriteLine("  Atan2(1, 1)   = " + Program.ToFourPlaces(Math.Atan2(1.0, 1.0)));
        Console.WriteLine("  Atan2(1, -1)  = " + Program.ToFourPlaces(Math.Atan2(1.0, -1.0)));
        Console.WriteLine();
    end function

    # ---- Measuring and choosing -----------------------------------------------------

    ##
        These keep the type they were given, so a distance between whole numbers is whole and a
        fraction stays exact. That is what lets the answer be counted with afterwards.
    ##
    # @summary: Abs, Min and Max, which keep the type they were given.
    function MeasuringAndChoosing()
        Console.WriteLine("== measuring and choosing ==");
        Console.WriteLine("  Abs(-3)       = " + Math.Abs(-3));
        Console.WriteLine("  Abs(-3.5)     = " + Math.Abs(-3.5));
        Console.WriteLine("  Abs(-3|4)     = " + Math.Abs(-3|4));

        Console.WriteLine("  Min(3, 7)     = " + Math.Min(3, 7));
        Console.WriteLine("  Min(3.5, 7.5) = " + Math.Min(3.5, 7.5));
        Console.WriteLine("  Min(1|3, 1|2) = " + Math.Min(1|3, 1|2));

        Console.WriteLine("  Max(3, 7)     = " + Math.Max(3, 7));
        Console.WriteLine("  Max(3.5, 7.5) = " + Math.Max(3.5, 7.5));
        Console.WriteLine("  Max(1|3, 1|2) = " + Math.Max(1|3, 1|2));
        Console.WriteLine();
    end function

    # ---- Rounding -------------------------------------------------------------------

    ##
        @summary: Floor, Ceiling and Round, the three ways from a real to an integer.

        @remarks: Each lands on a whole number, so each yields an integer and can be used as a
        count or an index. Between them they are the three honest answers, which is why there
        is no single conversion that would have to pick one without being asked.

        A half goes away from zero, the rule taught in school.
    ##
    function Rounding()
        Console.WriteLine("== rounding ==");
        Console.WriteLine("  Floor(3.7)    = " + Math.Floor(3.7));
        Console.WriteLine("  Ceiling(3.2)  = " + Math.Ceiling(3.2));
        Console.WriteLine("  Round(2.5)    = " + Math.Round(2.5));
        Console.WriteLine("  Round(-2.5)   = " + Math.Round(-2.5));

        # Below zero, flooring goes down rather than toward zero.
        Console.WriteLine("  Floor(-7|2)   = " + Math.Floor(-7|2));
        Console.WriteLine("  Ceiling(-7|2) = " + Math.Ceiling(-7|2));
        Console.WriteLine("  Round(5|2)    = " + Math.Round(5|2));

        # The answer is an integer, so it indexes.
        string[] names = {"zero", "one", "two", "three", "four"};
        Console.WriteLine("  names[Floor(3.7)] is " + names[Math.Floor(3.7)]);
        Console.WriteLine();
    end function

    # ---- Counting -------------------------------------------------------------------

    # @summary: Factorial, which counts arrangements and so takes a whole number.
    function Counting()
        Console.WriteLine("== counting ==");

        for n = 0 to 6
            Console.Write(Math.Factorial(n) + " ");
        end for

        Console.WriteLine();

        # Twenty is the largest a whole number holds. The next one overflows, and says
        # so rather than wrapping into a smaller wrong answer.
        Console.WriteLine("  Factorial(20) = " + Math.Factorial(20));

        try
            Console.WriteLine(Math.Factorial(21));
        catch OverflowException problem
            Console.WriteLine("  Factorial(21) does not fit in an integer");
        end try
    end function

end model
