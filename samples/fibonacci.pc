##
    The Fibonacci sequence, computed two ways.

    Both functions produce the same answers, and the difference between them is the point.
    The recursive one mirrors the definition exactly and is the easier of the two to read.
    The iterative one keeps two numbers and walks forward.

    The recursive version recomputes the same values over and over: asking for Fibonacci(30)
    calls Fibonacci(28) twice, Fibonacci(27) three times, and so on. Try raising the limit and
    watch where it stops being instant.
##

global model Program

    constant integer Limit = 15;

    function Main()
        Console.WriteLine("n    recursive   iterative");

        for n = 0 to Program.Limit
            Console.WriteLine(
                Program.Pad(n) + Program.Pad(Program.Recursive(n)) + Program.Iterative(n));
        end for
    end function

    # The definition, written out. Every recursion needs a case that does not recur.
    integer function Recursive(integer n)
        if n < 2
            yield n;
        end if

        yield Program.Recursive(n - 1) + Program.Recursive(n - 2);
    end function

    # The same sequence, carrying only the two numbers it actually needs.
    integer function Iterative(integer n)
        integer previous = 0;
        integer current = 1;

        for i = 0 until n
            integer next = previous + current;
            previous = current;
            current = next;
        end for

        yield previous;
    end function

    # A number followed by enough spaces to line the columns up.
    string function Pad(integer value)
        let text = "" + value;
        string padded = text;

        for i = text.Count() until 12
            padded = padded + " ";
        end for

        yield padded;
    end function

end model
