##
    Getting from one type to another.

    A conversion happens on its own only where nothing is lost and nothing would
    surprise a reader. Everywhere else it is asked for, and the asking is a member call that
    can be read.

    The rule to carry away: a conversion that could lose information or change what a value
    means is written down.
##

# @summary: The four suits, for showing what an enumeration converts to.
enumeration Suit
    Clubs,
    Diamonds,
    Hearts,
    Spades
end enumeration

# @summary: A shape of no particular kind, for asking what a value really is.
model Shape
    # @summary: A shape with nothing distinguishing it.
    public function Shape()
    end function

    # @summary: What kind of shape this is.
    # @yields: its name, which each kind answers for itself.
    public virtual string function Name()
        yield "shape";
    end function
end model

# @summary: A round shape, to be found among shapes with 'is' and reached with 'as'.
model Circle extends Shape
    # @summary: How far it reaches from its center.
    real radius;

    # @summary: A circle of the given radius.
    # @r: how far it reaches from its center.
    public function Circle(real r)
        this.radius = r;
    end function

    # @summary: What kind of shape this is.
    # @yields: "circle".
    public override string function Name()
        yield "circle";
    end function

    # @summary: How far it reaches from its center.
    # @yields: the radius, which only a Circle has.
    public real function Radius()
        yield this.radius;
    end function
end model

# @summary: A four-sided shape, so that not every shape is a circle.
model Square extends Shape
    # @summary: A square, which needs nothing to build.
    public function Square()
    end function

    # @summary: What kind of shape this is.
    # @yields: "square".
    public override string function Name()
        yield "square";
    end function
end model

shared model Program

    function Main()
        Program.HowANumberIsWritten();
        Program.Widening();
        Program.AskingForIt();
        Program.StringsAndCharacters();
        Program.UpAndDownTheFamily();
        Program.Enumerations();
    end function

    ##
        An integer becomes a real or a fraction on its own. Both hold every integer exactly,
        so there is nothing to lose and nothing to decide.
    ##
    ##
        A number has one value and several spellings. The base a whole number is written in
        changes nothing about it — 255, 0xFF and 0b1111_1111 are the same number, and comparing
        them says so.

        Format is the way out and a prefix is the way back, which is the pair worth knowing:
        anything printed in hexadecimal can be written down again as it was printed.

        An underscore groups digits for whoever reads the line and is not part of the number.
    ##
    function HowANumberIsWritten()
        Console.WriteLine("== one number, several spellings ==");

        integer plain = 255;
        integer hexadecimal = 0xFF;
        integer binary = 0b1111_1111;

        Console.WriteLine("  all the same: " + (plain == hexadecimal and hexadecimal == binary));
        Console.WriteLine("  as hex:       " + plain.Format("X"));
        Console.WriteLine("  as binary:    " + plain.Format("B"));
        Console.WriteLine("  and back:     " + 0xFF + ", " + 0b11111111);

        # Grouping is for the reader. A million is a million however it is written down.
        Console.WriteLine("  a million:    " + (1_000_000 == 1000000));

        ##
            An exponent says how far to move the point, so what it writes is a real whether or
            not a point was written. 1e3 is a real holding 1000; 1000 is how the integer is
            asked for.
        ##
        real scaled = 1.5e3;
        real small = 2.5e-3;

        Console.WriteLine("  1.5e3:        " + scaled);
        Console.WriteLine("  2.5e-3:       " + small);
        Console.WriteLine("  1e3 is real:  " + (1e3 == 1000.0));
    end function

    # @summary: Conversions that happen unasked, because nothing is lost.
    function Widening()
        real r = 7;
        fraction f = 7;

        Console.WriteLine("7 as a real is " + r + ", as a fraction " + f);
    end function

    ##
        A fraction and a real never convert on their own, in either direction.

        One third as a real is 0.33333333333333331, and one tenth as a fraction is
        3602879701896397 over 36028797018963968. Both are surprising enough that the program
        should say which it wants.
    ##
    function AskingForIt()
        fraction third = 1|3;
        real tenth = 0.1;

        Console.WriteLine("a third as a real is " + third.ToReal());
        Console.WriteLine("a tenth as a fraction is " + tenth.ToFraction());

        # Every type answers ToString(), which is what '+' uses to join one to a string.
        Console.WriteLine("and as text: " + third.ToString() + " " + tenth.ToString());
    end function

    # @summary: A string and a set of characters, which are two views of one thing.
    function StringsAndCharacters()
        character[] letters = "cast";
        string word = letters;

        letters.Insert('s');

        Console.WriteLine("letters: " + letters);
        Console.WriteLine("word:    " + word + ", now " + letters.Count + " letters");

        ##
            The two views converting into each other is not a rule about strings. An optional
            travels wherever the value it holds would, so the optional forms convert too, and
            one that holds nothing goes on holding nothing.

            Nothing is unwrapped by this. Reaching a plain string from a string? still means
            proving there is one.
        ##
        string? spoken = "hello";
        character[]? spelled = spoken;
        Console.WriteLine("spelled: " + spelled.Or({'?'}).Count + " letters");

        string? unsaid = Program.NothingToSay();
        character[]? unspelled = unsaid;
        Console.WriteLine("nothing stays nothing: " + (not unspelled.HasValue()));
    end function

    # @summary: An optional string that holds nothing, for showing what stays nothing.
    # @yields: an empty optional.
    string? function NothingToSay()
        string? none;
        yield none;
    end function

    ##
        A model becomes any of its ancestors on its own, because every circle is a shape.

        Going the other way is a question rather than a fact, so it is asked: 'is' tests, and
        'as' tries. A cast yields an optional, so a shape that is not a circle gives nothing
        back rather than failing.
    ##
    function UpAndDownTheFamily()
        Shape[] shapes = {new Circle(2.0), new Square(), new Circle(0.5)};

        loop each shape in shapes
            if shape is Square
                Console.WriteLine("a square, which has no radius to read");
            end if

            Circle? asCircle = shape as Circle;

            if asCircle.HasValue()
                Console.WriteLine("a circle of radius " + asCircle.Value().Radius());
            end if
        end loop
    end function

    ##
        An enumeration member tells you its ordinal, and an ordinal can be asked back for a
        member. That direction is a cast because a number need not name one.
    ##
    function Enumerations()
        Suit s = Suit.Hearts;

        Console.WriteLine(s + " is number " + s.ToInteger());

        loop for n = 1 to 4
            Suit? found = n as Suit;

            Console.WriteLine(
                n + " names " + if found.HasValue() then found.Value().ToString() else "no suit");
        end loop
    end function

end model
