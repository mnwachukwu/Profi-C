##
    Fractions built while the program runs.

    A literal like 3|4 is fixed when the program is written — both numerals are
    there in the source. Fraction.Create(n, d) builds one from values worked out at run time,
    which is what the numbers coming from a loop or a calculation need.

    What comes back is an ordinary fraction. It reduces, it carries its sign in the numerator,
    and every operator works on it.
##

shared model Program

    function Main()
        Console.WriteLine("== a table of unit fractions ==");

        ##
            Given one number, Create reads it as a whole one — the same as a denominator of 1.
            It is worth having only where nothing else says a fraction is wanted: 'let counted
            = 3;' holds an integer, while Create(3) holds 3|1.
        ##
        loop for d = 2 to 6
            let piece = Fraction.Create(1, d);
            Console.WriteLine("  1 over " + d + " is " + piece
                                  + ", and " + d + " of them make " + piece * Fraction.Create(d));
        end loop

        Console.WriteLine();
        Console.WriteLine("== it reduces and normalizes, exactly as a literal does ==");
        Console.WriteLine("  Fraction.Create(6, 8)   is " + Fraction.Create(6, 8));
        Console.WriteLine("  Fraction.Create(-3, -9) is " + Fraction.Create(-3, -9));

        # The sign always ends up on the numerator, so two spellings of the same
        # number really are the same number.
        Console.WriteLine("  Fraction.Create(5, -10) is " + Fraction.Create(5, -10));
        Console.WriteLine("  and equals -1|2?           " + (Fraction.Create(5, -10) == -1|2));

        Console.WriteLine();
        Console.WriteLine("== summing a series that literals could not express ==");
        Console.WriteLine("  1 + 1|2 + ... + 1|10 = " + Program.Harmonic(10));
        Console.WriteLine("  as a real:             " + Program.Harmonic(10).ToReal());

        Console.WriteLine();
        Console.WriteLine("== a denominator of zero ==");

        ##
            Written as a literal, this is refused before the program ever runs — the same
            way 1 / 0 is. Only a value the compiler cannot see reaches this point.
        ##
        integer denominator = 0;

        try
            Console.WriteLine(Fraction.Create(1, denominator));
        catch DivideByZeroException problem
            Console.WriteLine("  refused: " + problem.Message());
        end try
    end function

    ##
        @summary: The sum of 1|1 through 1|n, exactly.

        @remarks: Each term needs a denominator that only exists once the loop is running, so
        this cannot be written with literals at all.

        @n: how many terms to add.
        @yields: the exact rational sum.
    ##
    fraction function Harmonic(integer n)
        fraction total = 0;

        loop for d = 1 to n
            total = total + Fraction.Create(1, d);
        end loop

        yield total;
    end function

end model
