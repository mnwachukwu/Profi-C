##
    Leaving a loop early, and skipping a turn.

    'break' leaves the innermost loop it is inside. 'continue' abandons the rest of
    this turn and goes on to the next.

    Neither is necessary — every loop below could be written with a flag and a longer condition
    — but that is harder to read than the sentence it replaces, and the flag is one more thing
    to keep true.
##

global model Program

    function Main()
        Program.StoppingAtTheFirstMatch();
        Program.SkippingWhatDoesNotCount();
        Program.BothAtOnce();
        Program.BreakingOutOfTheInnerLoop();
    end function

    # ---- Stopping once the answer is known -----------------------------------------

    ##
        @summary: The first even number in a set.

        @remarks: Once it is found there is nothing left to learn, so the loop stops rather
        than walking the rest of the set to no purpose. The result is an optional because the
        set may hold no even number at all, which is why nothing here invents a -1.

        @values: the set to walk.
        @yields: the first even value, or nothing where there is none.
    ##
    integer? function FirstEven(integer[] values)
        integer? found;

        for each value in values
            if value % 2 == 0
                found = value;
                break;
            end if
        end for

        yield found;
    end function

    # @summary: Shows a loop stopping once the answer is known.
    function StoppingAtTheFirstMatch()
        integer? even = Program.FirstEven({7, 3, 12, 5, 8});
        Console.WriteLine("first even: " + even.Or(0));

        integer? none = Program.FirstEven({7, 3, 5});
        Console.WriteLine("none found: " + none.HasValue());
    end function

    # ---- Skipping the turns that do not count ----------------------------------------

    ##
        @summary: Adds up a day's takings, ignoring refunds.

        @remarks: A refund is recorded as a negative amount. The 'continue' says so once, at
        the top, instead of wrapping the rest of the body in an if.

        @amounts: every amount recorded, refunds among them.
        @yields: the total of the amounts that are not refunds.
    ##
    integer function TakingsFrom(integer[] amounts)
        integer total = 0;

        for each amount in amounts
            if amount < 0
                continue;
            end if

            total = total + amount;
        end for

        yield total;
    end function

    # @summary: Shows a turn being skipped rather than wrapped in an if.
    function SkippingWhatDoesNotCount()
        Console.WriteLine("takings: " + Program.TakingsFrom({40, -15, 60, 25, -10}));
    end function

    # ---- Both in one loop -------------------------------------------------------------

    ##
        @summary: Both in one loop, counting four even numbers and stopping.

        @remarks: A range loop works the same way, and 'continue' still moves the counter on —
        so this cannot loop forever the way a hand-written 'while' with a misplaced continue
        can.
    ##
    function BothAtOnce()
        integer counted = 0;

        for i = 1 to 20
            # Odd numbers are not being counted.
            if i % 2 == 1
                continue;
            end if

            counted = counted + 1;

            # Four is enough.
            if counted == 4
                Console.WriteLine("stopped at " + i);
                break;
            end if
        end for
    end function

    # ---- Which loop a break leaves ---------------------------------------------------

    ##
        @summary: Which loop a break leaves.

        @remarks: The innermost one, and no more. The outer loop below runs every one of its
        turns; only the inner one is cut short each time.
    ##
    function BreakingOutOfTheInnerLoop()
        for row = 1 to 3
            string line = "";

            for column = 1 to 5
                if column > row
                    break;
                end if

                line = line + column + " ";
            end for

            Console.WriteLine("row " + row + ": " + line);
        end for
    end function

end model
