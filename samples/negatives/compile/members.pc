##
    Members reached the wrong way.

    This program does not compile. Every member the language provides is a function, an
    instance member needs an instance, and a call that yields nothing has no result to use.
##

# Nothing here is run, so nothing reads what it declares and nothing keeps what it
# works out. That is the shape of every negative, and not the lesson of this one.
# ignore PC0409 in file

model Counter
    integer count;

    public function Counter(integer start)
        this.count = start;
    end function

    public integer function Value()
        yield this.count;
    end function
end model

shared model Program

    function Report()
        Console.WriteLine("reporting");
    end function

    function Main()
        integer[] xs = {1, 2, 3};

        # A 'new' is checked against the constructor it runs, as any other call is.
        Counter wrongType = new Counter("ten");
        Counter tooMany = new Counter(1, 2);

        # 'Distinct' is something to do rather than something a set has, so it is a function
        # and naming it is not calling it. 'Count' beside it is a value and reads correctly
        # without parentheses — which is the whole reason the two mistakes are worth telling
        # apart, and why each names which kind of member it found.
        Console.WriteLine(xs.Count);
        Console.WriteLine(xs.Distinct);

        # 'count' belongs to each Counter, not to the Counter type.
        Console.WriteLine(Counter.count);

        # Report yields nothing, so there is no result to assign.
        integer answer = Program.Report();

        # Nor to call a member on.
        Console.WriteLine(Program.Report().ToString());

        # A set has no member of that name.
        Console.WriteLine(xs.Length());
    end function

end model
