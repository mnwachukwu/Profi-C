##
    Values used where they do not fit.

    This program does not compile. The type checker reports each mismatch where it happens,
    naming both what arrived and what was wanted.
##

# Nothing here is run, so nothing reads what it declares and nothing keeps what it
# works out. That is the shape of every negative, and not the lesson of this one.
# ignore PC0409 in file
# ignore PC0410 in file

model Shape

    ##
        'let' declares a local, where the value it holds is written beside it. A field is read
        in every function of its type, and by callers who never see this line, so it says what
        it holds. The rule is about how far a declaration is read from, which is the same thing
        that makes 'this.' required on a field and not on a local.
    ##
    let inferred = 0;

end model

model Circle extends Shape
end model

shared model Program
    function Main()
        # A string is not a number.
        integer count = "twelve";

        # Neither fraction nor real converts to the other on its own.
        real r = 1|2;
        fraction f = 0.5;

        # An operator has to be defined for both sides.
        let bad = true * 2;

        # A parent does not convert to a child.
        Circle c = new Shape();

        # Boxing does not exist, so a value type never becomes a Model.
        Model m = 1;

        # The branches of an if expression must agree.
        let branches = if true then 1 else "one";

        # Division by a literal zero is refused before the program runs.
        Console.WriteLine(1 / 0);

        # 'function' declares one or makes one on the spot; 'delegate' writes the type of one.
        # Reaching for the declaring word here is the most natural mistake in the language,
        # and it is read as the type meant so that only the one thing is reported.
        integer function(integer) twice = (n) yield n * 2;

        # And 'Function' is the root every one of them descends from, not a way to spell a
        # particular shape, so it takes no parentheses.
        Function(integer) thrice = (n) yield n * 3;

        ##
            'Reference.Equals' asks whether two names reach one object. A value is not somewhere
            a name points, so it has no answer — which is the same rule that refuses 'Model m = 1'
            above, reaching a case the conversion cannot see because this member takes anything.
        ##
        Console.WriteLine(Reference.Equals(1, 1));
    end function
end model
