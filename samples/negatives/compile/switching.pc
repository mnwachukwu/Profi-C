##
Switches that do not hold together.

This program does not compile, except for the last switch, which is a warning: it runs and
does something defensible, but a member added to Suit tomorrow would fall through it
silently, and that is the thing worth being told about.
##

enumeration Suit
    Hearts, Diamonds, Clubs, Spades
end enumeration

global model Program
    function Main()
        Suit suit = Suit.Hearts;
        integer code = 1;
        real measured = 1.5;
        integer notConstant = 3;

        # Equality on a real is not something a case label can be trusted to answer.
        switch measured
            case 1.5:
                Console.WriteLine("one and a half");
        end switch

        # A label is a constant, fixed when the program is written.
        switch code
            case notConstant:
                Console.WriteLine("three");
        end switch

        # One value cannot be handled twice; the second case could never run.
        switch code
            case 1:
                Console.WriteLine("one");
            case 1:
                Console.WriteLine("one again");
        end switch

        # A label has to be something the value could be.
        switch suit
            case "hearts":
                Console.WriteLine("hearts");
        end switch

        # Two members have no case and there is no default. This one is a warning.
        switch suit
            case Suit.Hearts:
            case Suit.Diamonds:
                Console.WriteLine("red");
        end switch
    end function
end model
