##
    Reading an optional without proving there is anything in it.

    This program does not compile. An optional cannot be read as a plain value, and the
    members of what it holds are out of reach until presence is proven — which is what the
    language has instead of null.
##

model Account
    public integer balance;

    public string function Describe()
        yield "an account";
    end function
end model

shared model Program
    function Main()
        integer? maybe;
        Account? found;

        # Reading it as a plain value. The message names all three ways in.
        integer total = maybe;

        # Reaching a member of what it holds, without narrowing first.
        Console.WriteLine(found.Describe());

        # Arithmetic on one, likewise.
        Console.WriteLine(maybe + 1);

        # Narrowing proves the first one only; the second is still an optional.
        if maybe.HasValue()
            Console.WriteLine(found.balance);
        end if

        # One '?' and no more. A second says nothing new, and the two ways of being empty it
        # would make cannot be told apart: nothing an optional offers sees past the first
        # level, so "absent" and "present, holding an absence" answer alike to every question.
        integer?? twice;
    end function
end model
