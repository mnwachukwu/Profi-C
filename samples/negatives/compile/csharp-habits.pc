##
    Habits from other languages, and what Profi-C says about each.

    This program does not compile. Every line below is a spelling a C#, Java, or Python
    author reaches for without thinking, and each one is named rather than left to produce a
    confusing parse error further down the file.
##

shared model Program
    function Main()
        integer count = 1;
        boolean ready = true;

        # '&&' and '||' are symbols; Profi-C spells them as words.
        if ready && count > 0
            Console.WriteLine("both");
        end if

        if ready || count > 0
            Console.WriteLine("either");
        end if

        # '!' likewise.
        if !ready
            Console.WriteLine("negated");
        end if

        # There is no compound assignment and no increment.
        count += 5;
        count++;

        # Python raises to a power with '**'; Profi-C uses '^'.
        Console.WriteLine(2 ** 8);

        # A lambda's body follows 'yield', not an arrow.
        integer delegate(integer) twice = (integer n) => n * 2;
        integer delegate(integer) thrice = (integer n) -> n * 3;

        # Leaving a type out asks the surrounding code, and 'let' has nothing to say.
        let unknown = (n) yield n + 1;

        # A range loop's counter carries no type.
        for integer i = 1 to 3
            Console.WriteLine(i);
        end for
    end function
end model
