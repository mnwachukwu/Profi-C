##
    Insertion sort.

    Walk left to right. Everything behind the current position is already in order, so take
    the current value out, slide the larger values right to make a gap, and drop it in.

    It is the sort people actually use by hand for a deck of cards, and it is the clearest one
    to read. It is also slow on large sets — every value may have to slide past every other —
    which is a fair thing to notice early.
##

global model Program

    function Main()
        integer[] values = {29, 10, 14, 37, 13, 5, 42, 1};

        Console.WriteLine("before: " + Program.Render(values));
        Console.WriteLine("after:  " + Program.Render(Program.Sorted(values)));
        Console.WriteLine("back:   " + Program.RenderBackwards(Program.Sorted(values)));
    end function

    ##
        Yields a sorted copy, leaving the original alone. A set is a reference, so sorting in
        place would change what the caller passed in — surprising unless it was asked for.
    ##
    integer[] function Sorted(integer[] values)
        integer[] result = {};

        for each value in values
            result.Insert(value);
        end for

        for i = 1 until result.Count()
            integer current = result[i];
            integer j = i - 1;

            ##
                'and' stops as soon as the left side is false, which matters here: once j
                reaches -1 there is no result[j] to read, and the second test is never run.
            ##
            while j >= 0 and result[j] > current
                result[j + 1] = result[j];
                j = j - 1;
            end while

            result[j + 1] = current;
        end for

        yield result;
    end function

    string function Render(integer[] values)
        string text = "";

        for i = 0 until values.Count()
            if i > 0
                text = text + ", ";
            end if

            text = text + values[i];
        end for

        yield text;
    end function

    ##
        The same values read from the back. 'step' says how far each turn moves, and a negative
        one counts down — so this walks the last index to the first.

        Without it a range loop always moves by one, and reading a set backwards would mean
        subtracting the counter from the count and thinking about it every time.
    ##
    string function RenderBackwards(integer[] values)
        string text = "";

        for i = values.Count() - 1 to 0 step -1
            if i < values.Count() - 1
                text = text + ", ";
            end if

            text = text + values[i];
        end for

        yield text;
    end function

end model
