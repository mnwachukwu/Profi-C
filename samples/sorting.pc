##
    Insertion sort.

    Walk left to right. Everything behind the current position is already in order,
    so take the current value out, slide the larger values right to make a gap, and drop it in.

    It is the sort people use by hand for a deck of cards, and the clearest one to read. It is
    also slow on large sets, since every value may have to slide past every other.
##

shared model Program

    function Main()
        integer[] values = {29, 10, 14, 37, 13, 5, 42, 1};

        Console.WriteLine("before: " + Program.Render(values));
        Console.WriteLine("after:  " + Program.Render(Program.Sorted(values)));
        Console.WriteLine("back:   " + Program.RenderBackwards(Program.Sorted(values)));
    end function

    ##
        @summary: Puts a set in order, leaving the original alone.

        @remarks: A set is a reference, so sorting in place would change what the caller passed
        in — surprising unless it was asked for.

        @values: the set to sort.
        @yields: a new set holding the same values in order.
    ##
    integer[] function Sorted(integer[] values)
        integer[] result = {};

        loop each value in values
            result.Insert(value);
        end loop

        loop for i = 1 until result.Count
            integer current = result[i];
            integer j = i - 1;

            ##
                'and' stops as soon as the left side is false, which matters here: once j
                reaches -1 there is no result[j] to read, and the second test is never run.
            ##
            loop while j >= 0 and result[j] > current
                result[j + 1] = result[j];
                j = j - 1;
            end loop

            result[j + 1] = current;
        end loop

        yield result;
    end function

    ##
        @summary: Writes a set out as one comma-separated line.
        @values: the set to write.
        @yields: the values in order, separated by commas.
    ##
    string function Render(integer[] values)
        string text = "";

        loop for i = 0 until values.Count
            if i > 0
                text = text + ", ";
            end if

            text = text + values[i];
        end loop

        yield text;
    end function

    ##
        @summary: The same values read from the back.

        @remarks: 'stepby' says how far each turn moves, and a negative one counts down, so this
        walks the last index to the first. Without it a range loop always moves by one, and
        reading a set backwards would mean subtracting the counter from the count every time.

        @values: the set to write.
        @yields: the values in reverse, separated by commas.
    ##
    string function RenderBackwards(integer[] values)
        string text = "";

        loop for i = values.Count - 1 to 0 stepby -1
            if i < values.Count - 1
                text = text + ", ";
            end if

            text = text + values[i];
        end loop

        yield text;
    end function

end model
