##
    Binary search, and what to do when the answer is "it is not there".

    In most languages this function returns -1 for a miss, and every caller is
    trusted to remember. Forgetting compiles fine and goes wrong later, somewhere else.

    There is no null here and no sentinel to reach for. The function yields 'integer?', so a
    caller cannot read the index until it has proved there is one. The check is not good
    manners — it is the only way to get at the value.
##

global model Program

    function Main()
        integer[] sorted = {2, 5, 8, 12, 16, 23, 38, 56, 72, 91};

        Program.Report(sorted, 23);
        Program.Report(sorted, 91);
        Program.Report(sorted, 2);
        Program.Report(sorted, 40);
    end function

    ##
        @summary: Writes where a value sits, or that it is absent.
        @sorted: the set to look in.
        @wanted: the value to look for.
    ##
    function Report(integer[] sorted, integer wanted)
        integer? found = Program.IndexOf(sorted, wanted);

        ##
            HasValue narrows 'found' for the rest of this block, so it reads as a plain
            integer inside the guard. Outside it, the same name will not add to a string.
        ##
        if found.HasValue()
            Console.WriteLine(wanted + " is at index " + found);
        else
            Console.WriteLine(wanted + " is not in the set");
        end if
    end function

    ##
        @summary: Finds where a value sits in a sorted set.

        @remarks: Halve the range each time: look at the middle, and throw away the half the
        answer cannot be in. Ten values take at most four looks, and a thousand take at most
        ten.

        @sorted: a set already in order, which the halving depends on.
        @wanted: the value to look for.
        @yields: its index, or nothing where the set does not hold it.
    ##
    integer? function IndexOf(integer[] sorted, integer wanted)
        integer low = 0;
        integer high = sorted.Count() - 1;

        while low <= high
            integer middle = (low + high) / 2;

            if sorted[middle] == wanted
                yield middle;
            else if sorted[middle] < wanted
                low = middle + 1;
            else
                high = middle - 1;
            end if
        end while

        # The range closed without finding it, so there is no index to give back.
        integer? missing;
        yield missing;
    end function

end model
