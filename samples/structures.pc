##
    Values and references, and what changes when you copy one.

    A structure is a value: assigning one copies it, and the copy has nothing to do
    with the original afterwards. A model is a reference: assigning one copies the reference,
    and both names then reach the same object.

    That is the whole difference, and every surprising thing below follows from it.
##

# @summary: A place on a grid, held by value.
structure Point
    # @summary: How far across.
    public integer X;

    # @summary: How far down.
    public integer Y;

    # @summary: A point at the given coordinates.
    # @x: how far across.
    # @y: how far down.
    public function Point(integer x, integer y)
        this.X = x;
        this.Y = y;
    end function

    ##
        @summary: How far away another point is, counted in steps along the grid.

        @remarks: Measuring keeps the type it measured, so the distance between two whole
        coordinates is a whole number and can be counted with.

        @other: the point to measure to.
        @yields: the number of grid steps between them.
    ##
    public integer function ManhattanFrom(Point other)
        yield Math.Abs(this.X - other.X) + Math.Abs(this.Y - other.Y);
    end function
end structure

# @summary: A name pinned to somewhere, held by reference.
model Marker
    # @summary: What this marker is called.
    public string Label;

    # @summary: A marker with the given name.
    # @label: what to call it.
    public function Marker(string label)
        this.Label = label;
    end function
end model

##
    @summary: A place and the marker standing on it.

    @remarks: A structure may hold a model, and this is the case to look at closely: copying
    the structure copies the reference, not the model. Both copies then see one marker.
##
structure Pin
    # @summary: Where the pin sits, copied with the pin.
    public Point Where;

    # @summary: What it is labeled, shared with every copy.
    public Marker Tag;

    # @summary: A pin at a place, carrying a marker.
    # @where: the place it sits.
    # @tag: the marker it carries.
    public function Pin(Point where, Marker tag)
        this.Where = where;
        this.Tag = tag;
    end function
end structure

shared model Program

    function Main()
        Program.CopyingAStructure();
        Program.CopyingAModel();
        Program.WhenAStructureHoldsAModel();
        Program.Equality();
        Program.PassingThemToFunctions();
        Program.InsideASet();
    end function

    # ---- A structure copies ------------------------------------------------------

    # @summary: Copying a structure, which copies the value.
    function CopyingAStructure()
        Point a = new Point(1, 2);
        Point b = a;

        b.X = 99;

        Console.WriteLine("a.X is " + a.X + ", b.X is " + b.X);
    end function

    # ---- A model does not ---------------------------------------------------------

    # @summary: Copying a model, which copies the reference and not the object.
    function CopyingAModel()
        Marker first = new Marker("start");
        Marker second = first;

        second.Label = "moved";

        Console.WriteLine("first is " + first.Label + ", second is " + second.Label);
        Console.WriteLine("same object: " + Reference.Equals(first, second));
    end function

    # ---- A structure holding a model ------------------------------------------------

    ##
        Copying the pin copies the point, because a point is a value. It copies the reference
        to the marker, because a marker is not. So moving the copy leaves the original where it
        was, while renaming the marker is seen through both.
    ##
    function WhenAStructureHoldsAModel()
        Pin original = new Pin(new Point(0, 0), new Marker("home"));
        Pin copy = original;

        copy.Where.X = 5;
        copy.Tag.Label = "renamed";

        Console.WriteLine("original point: " + original.Where.X + ", copy point: " + copy.Where.X);
        Console.WriteLine("original tag:   " + original.Tag.Label);
        Console.WriteLine("one marker:     " + Reference.Equals(original.Tag, copy.Tag));
    end function

    # ---- What equality means for each -------------------------------------------------

    ##
        '==' compares values, all the way down, for both kinds. Two separately built points are
        equal because nothing distinguishes them, and so are two separately built markers.
        Reference.Equals asks the other question, and only a reference can answer it.
    ##
    function Equality()
        Point here = new Point(3, 4);
        Point there = new Point(3, 4);

        Console.WriteLine("points equal:   " + (here == there));

        Marker one = new Marker("x");
        Marker other = new Marker("x");

        Console.WriteLine("markers equal:  " + (one == other));
        Console.WriteLine("same object:    " + Reference.Equals(one, other));

        # '!=' asks the opposite of '=='. Changing one field is enough to separate two values
        # that were equal a moment before, since the comparison reaches all the way down.
        Marker renamed = new Marker("y");

        Console.WriteLine("one differs:    " + (one != renamed));
        Console.WriteLine("and by value:   " + (here != new Point(3, 5)));
    end function

    # ---- Across a function call ----------------------------------------------------

    ##
        An argument is assigned to a parameter, so the same rule applies at the boundary: a
        structure arrives as a copy and a model arrives as the same object.
    ##
    function MoveIt(Point point, Marker marker)
        point.X = 100;
        marker.Label = "changed";
    end function

    # @summary: What a function can and cannot change about what it was passed.
    function PassingThemToFunctions()
        Point point = new Point(1, 1);
        Marker marker = new Marker("before");

        Program.MoveIt(point, marker);

        Console.WriteLine("point kept " + point.X + ", marker became " + marker.Label);
        Console.WriteLine("distance:   " + point.ManhattanFrom(new Point(4, 5)));

        # Handed back, which is a copy for the same reason: the result is stored.
        Console.WriteLine("moved copy: " + Program.Moved(point).X + ", original " + point.X);
    end function

    ##
        @summary: A point moved to the right.

        @remarks: Changing the parameter changes this function's own copy. Nothing outside sees
        it, so handing the copy back is the only way to give the caller the new value.

        @given: the point to move.
        @yields: a point ten to the right of it.
    ##
    Point function Moved(Point given)
        given.X = given.X + 10;
        yield given;
    end function

    # ---- Inside a set -----------------------------------------------------------------

    ##
        A set holds the structures themselves rather than copies of them, so reaching through
        the set to change one changes the one in the set. Taking it out is a different act: that
        stores it somewhere, and storing copies.

        The rule is the same everywhere and worth saying once more, because these two lines look
        alike and do not agree: **reading does not copy, keeping does.**
    ##
    function InsideASet()
        Point[] grid = {new Point(1, 1), new Point(2, 2)};

        # Reached through the set, so the point in the set moves.
        grid[0].X = 99;

        # Taken out of the set, so this is a copy and the set is untouched.
        Point taken = grid[1];
        taken.X = 77;

        Console.WriteLine("in the set: " + grid[0].X + ", " + grid[1].X);
        Console.WriteLine("taken out:  " + taken.X);

        ##
            'Reference.Equals' is not asked here, and cannot be: a value has no identity to
            compare, so the question is refused rather than answered. Either answer would teach
            something false — that a point is somewhere, or that two equal points differ — and
            '==' is the question a reader meant anyway.
        ##
        Console.WriteLine("equal:      " + (grid[1] == taken));
    end function

end model
