# Every literal form Profi-C can write.

global model Literals

    # ---- Integers ----------------------------------------------------------------

    constant integer Zero = 0;
    constant integer Small = 7;
    constant integer Padded = 007;
    constant integer Large = 2147483647;

    # ---- Reals, which need digits on both sides of the point --------------------

    constant real Half = 0.5;
    constant real Pi = 3.14159;
    constant real Whole = 1.0;

    # ---- Fractions, which are exact rationals ---------------------------------

    constant fraction Third = 1|3;
    constant fraction Sixth = 1|6;
    constant fraction Approximation = 22|7;

    # ---- Characters, including every escape ----------------------------------

    constant character Letter = 'A';
    constant character Digit = '7';
    constant character Space = ' ';
    constant character Newline = '\n';
    constant character Tab = '\t';
    constant character Return = '\r';
    constant character Nul = '\0';
    constant character Backslash = '\\';
    constant character Quote = '\'';
    constant character DoubleQuote = '\"';
    constant character Unicode = 'é';

    # ---- Strings ------------------------------------------------------------------

    constant string Empty = "";
    constant string Word = "Profi-C";
    constant string Spaced = "with several spaces";
    constant string Punctuated = "commas, semicolons; braces {} and brackets []";
    constant string Escaped = "a newline \n a tab \t a backslash \\ a quote \"";
    constant string Accented = "café";

    # A brace is ordinary; only a pair opens a hole, and escaping the first writes one.
    constant string Braced = "a set is written {1, 2}";
    constant string EscapedBrace = "a hole is written \{\{ name }}";

    # ---- Block strings, which read nothing they hold ------------------------------

    constant string Block = """no escape \n, no hole {{x}}, and a " as well""";

    constant string Spanning = """
        A block over several lines. The indentation of the closing quotes comes off
        every line, so what this holds starts at the left margin.
        """;

    # ---- Strings with holes in them ---------------------------------------------------

    ##
        Not constants: a hole holds an expression, and an expression is not folded before the
        program runs. Written in a function for that reason alone.
    ##
    function Interpolated()
        let count = 2;

        let one = "{{count}}";
        let around = "before {{count}} after";
        let several = "{{count}} and {{count + 1}} and {{count * 2}}";
        let adjacent = "{{count}}{{count}}";
        let formatted = "{{count:N2}}";
        let holding = "{{ "a string in a hole" }}";
        let nested = "{{ {1, 2}.Count() }}";
    end function

    # ---- Booleans ---------------------------------------------------------------

    constant boolean Yes = true;
    constant boolean No = false;

    # ---- Sets, whose literals use braces ------------------------------------

    function Sets()
        integer[] numbers = {1, 2, 3};
        string[] words = {"one", "two"};
        integer[] empty = {};
        integer[][] nested = {{1, 2}, {3}};
    end function

end model
