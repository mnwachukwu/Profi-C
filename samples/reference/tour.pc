##
    A tour of Profi-C.

    Every construct in the grammar appears here at least once. The file is meant to be
    read, and to be scanned by the compiler as a test that nothing in the grammar is
    unreachable.
##

##
    A using names a namespace declared somewhere in this compilation, and brings its types into
    this file under their bare names. The one below is declared at the foot of this same file:
    directives are unordered with respect to what they reach, which is the whole point of them.
##
using Tour.Shapes;

namespace Tour

    # ---- Enumerations ----------------------------------------------------------

    public enumeration Color
        Red,
        Green = 10,
        Blue,
    end enumeration

    # ---- Structures, which are values rather than references -------------------

    public structure Pair
        public integer Left;
        public integer Right;

        public function Pair(integer left, integer right)
            this.Left = left;
            this.Right = right;
        end function
    end structure

    # ---- A model with inheritance ------------------------------------------------

    ##
        Every visibility on one model. A field with no word reaches its own type; protected adds
        whatever extends it; internal adds the rest of the project; public adds everywhere. The
        same four words apply to a type, except that a type says nothing far more often than it
        says public — so silence there means the project, as it means the type here.
    ##
    public abstract model Shape
        integer sides;
        protected string name;
        internal integer revision;

        public function Shape(string label)
            this.name = label;
            this.sides = 0;
            this.revision = 1;
        end function

        public virtual string function Describe()
            yield this.name;
        end function

        # Left open: declared, and ended at a semicolon for a descendant to write.
        public abstract real function Area();
    end model

    public sealed model Square extends Shape
        real edge;

        public function Square(real length)
            base("square");
            this.edge = length;
        end function

        public override string function Describe()
            yield base.Describe();
        end function

        public override real function Area()
            yield this.edge * this.edge;
        end function

        # A nested model, which holds no reference to the model it sits inside.
        # One that needs its enclosing instance takes it as a constructor argument,
        # exactly as a C# nested class does.
        public model Corner
            Shape owner;

            public function Corner(Shape shape)
                this.owner = shape;
            end function

            public string function Describe()
                yield this.owner.Describe();
            end function
        end model
    end model

    # ---- Every statement and expression form ---------------------------------

    shared model Tour

        constant integer Limit = 10;
        constant real Half = 1.0 / 2.0;

        function Statements(integer input, string text, Shape shape)

            # Declarations, inferred and explicit.
            let inferred = 1;
            integer explicitly = 2;
            integer uninitialized;
            constant character Marker = 'x';

            # Every type form.
            integer[] numbers = {1, 2, 3};
            Shape? maybeShape;
            Shape?[] optionalShapes = {};
            Shape[]? maybeShapes;
            integer delegate(integer, integer) comparator;
            integer delegate(integer, integer)? maybeComparator;
            delegate(string)[] handlers = {};

            # An anonymous block introduces a scope and closes with a bare end.
            begin
                integer scratch = 0;
                scratch = scratch + 1;
            end

            # Branching. An else-if chain closes once.
            if input > Tour.Limit
                explicitly = 1;
            else if input == Tour.Limit
                explicitly = 2;
            else
                explicitly = 3;
            end if

            # The conditional expression, which fills the role of a ternary.
            let label = if input > 0 then "positive" else "other";

            # Loops. "to" is inclusive, "until" is exclusive.
            loop for i = 1 to 10
                explicitly = explicitly + i;
            end loop

            loop for i = 10 until 0 stepby -1
                explicitly = explicitly - i;
            end loop

            loop each letter in text
                Console.WriteLine("saw a letter");
            end loop

            loop while explicitly > 0
                explicitly = explicitly - 1;

                if explicitly == 5
                    continue;
                end if

                if explicitly == 2
                    break;
                end if
            end loop

            # Multi-way branching. No fallthrough, so no break is needed.
            switch input
                case 1:
                    Console.WriteLine("one");
                case 2:
                case 3:
                    Console.WriteLine("two or three");
                default:
                    Console.WriteLine("something else");
            end switch

            # Exceptions.
            try
                throw new ArgumentException();
            catch ArgumentException problem
                Console.WriteLine("caught it");
            finally
                Console.WriteLine("always runs");
            end try

            # Type tests and casts. "as" yields an optional.
            let isSquare = shape is Square;
            let asSquare = shape as Square;

            # Optionals are read only once presence is proven.
            if maybeShape.HasValue()
                let unwrapped = maybeShape.Value();
            end if

            let fallback = maybeShape.Or(shape);

            # Both lambda forms. The type being assigned to says what the parameters
            # hold, so both leave them out.
            comparator = function(a, b)
                yield a - b;
            end function;

            maybeComparator = (a, b) yield a - b;

            # A "let" says nothing about what it holds, so this one writes its own.
            let flipped = (integer n) yield -n;

            # A function nested in a function body, capturing its locals. Functions
            # may be declared here; types may not, since a type introduced by a
            # statement would entangle name resolution with statement order.
            integer function Doubled()
                yield explicitly * 2;
            end function

            # Construction, indexing, member access, and calls. A structure is
            # constructed the same way a model is; what differs is that the result
            # is a value, and cannot be stored in a Model variable until v3.
            let square = new Square(2.0);
            let pair = new Pair(3, 4);
            let first = numbers[0];
            let described = square.Describe();
            let total = numbers.Count;

            # Every operator, across all nine precedence levels.
            let arithmetic = 1 + 2 - 3 * 4 / 5 % 6;
            let negated = -arithmetic;
            let compared = 1 < 2 and 3 > 2 or not (4 <= 5) and 6 >= 7;
            let equated = 1 == 2 or 1 != 2;
            let mixed = 22|7;
            let flag = true and false;

            # Enumerations convert in both directions.
            let color = Color.Green;
            let ordinal = color.ToInteger();
            let recovered = 10 as Color;

            # Printing. Write leaves the cursor in place; WriteLine ends the line.
            Console.Write("no newline after this");
            Console.WriteLine();
            Console.WriteLine(explicitly);
            Console.WriteLine(Tour.Half);
            Console.WriteLine(Marker);
            Console.WriteLine(flag);
            Console.WriteLine(mixed);
            Console.WriteLine(shape);

            # A non-string operand converts implicitly when joined to a string.
            Console.WriteLine("the answer is " + explicitly);

            # The same sentence with the value written in place. A pair of braces holds an
            # expression; a colon after it says how to write what the expression yields.
            Console.WriteLine("the answer is {{explicitly}}");
            Console.WriteLine("to two places: {{Tour.Half:F2}}");

            # Three quotes hold text exactly as written: no escape is read, no hole is looked
            # for, and the indentation of the closing quotes comes off every line.
            Console.WriteLine("""
                A block string, which holds a \ and a " and a {{ without reading any of them.
                """);

            yield;
        end function

        string function WithValue()
            yield "a value";
        end function

    end model

    ##
        Polygon is declared in Tour.Shapes, which is nested inside this namespace rather than
        around it — so the walk outward never reaches it, and the 'using' at the top of the file
        is what makes this name resolve.
    ##
    model Surveying
        public integer function SidesOf(Polygon shape)
            # Written out, a name reaches the same type with no 'using' behind it. What comes
            # before the last part is read the way a bare name is: from here, then outward.
            Tour.Shapes.Polygon same = shape;
            yield same.sides;
        end function
    end model

end namespace

##
    A second namespace, nested under the first by writing its dotted name. What it holds is
    reached from above without qualifying it, because the file said 'using Tour.Shapes'.
##
namespace Tour.Shapes

    public model Polygon
        public integer sides;

        public function Polygon(integer count)
            this.sides = count;
        end function
    end model

end namespace
