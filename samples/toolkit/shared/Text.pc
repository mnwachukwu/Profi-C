##
    Shared text helpers, in a folder of their own.

    This file is not beside the program that uses it, so the folder rule cannot find it. The
    program names it with an import.
##

model Text

    public shared string function Repeat(string what, integer times)
        string built = "";

        loop for _ = 1 to times
            built = built + what;
        end loop

        yield built;
    end function

    public shared string function Pad(string what, integer width)
        yield what + Text.Repeat(" ", Math.Max(0, width - what.Count));
    end function

end model
