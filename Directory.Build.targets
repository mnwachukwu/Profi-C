<Project>

  <!--
    Where "dotnet publish" puts things.

    Read after each project rather than before it, which is the whole reason this is a
    .targets file and not the .props beside it: OutputType is set in the project body, so a
    condition on it is only answerable once that body has been read.

    The two commands land together in one folder, which is what a reader puts on their PATH.
    Everything else is left out of publishing entirely: a library has nothing to ship on its
    own, and a test project would otherwise scatter its harness beside the commands.

    One folder means one configuration at a time: publishing Debug over Release replaces what
    is there rather than sitting beside it. Publishing defaults to Release, which is what
    belongs in a folder a reader runs from.

    The browser build is left out of it. It is an Exe because a .NET WebAssembly build must
    have an entry point, not because anybody runs it — it is a folder of files a page fetches,
    and sending it here would overwrite the commands with something nobody can type. It keeps
    the ordinary publish folder inside its own project instead.
  -->

  <PropertyGroup Condition="'$(OutputType)' == 'Exe'
                            and '$(IsTestProject)' != 'true'
                            and '$(RuntimeIdentifier)' != 'browser-wasm'">
    <PublishDir>$(MSBuildThisFileDirectory)dist\</PublishDir>
  </PropertyGroup>

  <PropertyGroup Condition="'$(OutputType)' != 'Exe' or '$(IsTestProject)' == 'true'">
    <IsPublishable>false</IsPublishable>
  </PropertyGroup>

</Project>
