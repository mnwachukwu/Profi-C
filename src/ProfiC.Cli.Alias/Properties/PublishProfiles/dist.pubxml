<?xml version="1.0" encoding="utf-8"?>
<!--
  Publishes profi-c and pfc into the repository's dist folder, which is where a local
  install points. Publishing the alias project rather than the driver is deliberate: it
  references the driver, so one publish produces both executables side by side.

  dist is ignored by git. Nothing here is needed to build or test.
-->
<Project>
  <PropertyGroup>
    <PublishProtocol>FileSystem</PublishProtocol>
    <_TargetId>Folder</_TargetId>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <TargetFramework>net10.0</TargetFramework>
    <!-- Relative to the project directory, not to this file. -->
    <PublishDir>..\..\dist\</PublishDir>
    <SelfContained>false</SelfContained>
  </PropertyGroup>
</Project>
